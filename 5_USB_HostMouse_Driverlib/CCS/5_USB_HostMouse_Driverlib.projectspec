<projectSpec>
  <project
        name="5_USB_HostMouse_Driverlib"
        device="TMS320F28P650DK9"
        cgtVersion="22.6.3.LTS"
        products="C2000WARE"
        outputFormat="ELF"
        launchWizard="False"
        linkerCommandFile=""
        >
    <!--
      자기완결형(self-contained) 프로젝트입니다.
      F28P65x On-Chip USB0을 호스트 모드로 사용해 USB 마우스를 연결하고,
      좌우 이동에 따라 (8) 범용 LED 16개 블록을 제어합니다.
    -->
    <configuration name="CPU1_RAM"
        compilerBuildOptions="--opt_level=off -I${PROJECT_ROOT} -I${PROJECT_ROOT}/device -I${PROJECT_ROOT}/device/driverlib -I${PROJECT_ROOT}/usb -I${PROJECT_ROOT}/usb/include --define=ccs_c2k -v28 -ml -mt --cla_support=cla2 --define=RAM --float_support=fpu64 --tmu_support=tmu1 --define=DEBUG --define=CPU1 --gen_func_subsections=on --diag_warning=225 --diag_suppress=10063"
        linkerBuildOptions="--entry_point code_start --stack_size=0x3F8 --heap_size=0x200 -i${PROJECT_ROOT} -i${PROJECT_ROOT}/device -i${PROJECT_ROOT}/usb driverlib.lib usblib.lib" />
    <configuration name="CPU1_FLASH"
        compilerBuildOptions="--opt_level=off -I${PROJECT_ROOT} -I${PROJECT_ROOT}/device -I${PROJECT_ROOT}/device/driverlib -I${PROJECT_ROOT}/usb -I${PROJECT_ROOT}/usb/include --define=ccs_c2k --define=_FLASH -v28 -ml -mt --cla_support=cla2 --float_support=fpu64 --tmu_support=tmu1 --define=DEBUG --define=CPU1 --gen_func_subsections=on --diag_warning=225 --diag_suppress=10063"
        linkerBuildOptions="--entry_point code_start --stack_size=0x3F8 --heap_size=0x200 --define=_FLASH -i${PROJECT_ROOT} -i${PROJECT_ROOT}/device -i${PROJECT_ROOT}/usb driverlib.lib usblib.lib" />

    <file action="copy" path="../driverlib.lib" targetDirectory="" applicableConfigurations="CPU1_RAM, CPU1_FLASH" />
    <file action="copy" path="../usblib.lib" targetDirectory="" applicableConfigurations="CPU1_RAM, CPU1_FLASH" />
    <file action="copy" path="../28p65x_generic_ram_lnk_cpu1.cmd" targetDirectory="" applicableConfigurations="CPU1_RAM" />
    <file action="copy" path="../28p65x_generic_flash_lnk_cpu1.cmd" targetDirectory="" applicableConfigurations="CPU1_FLASH" />
    <file action="copy" path="../targetConfigs/TMS320F28P650DK9.ccxml" targetDirectory="targetConfigs" />
    <file action="copy" path="../device" targetDirectory="" />
    <file action="copy" path="../usb" targetDirectory="" />
    <file action="copy" path="../usb_hal.h" targetDirectory="" />
    <file action="copy" path="../usb_hal.c" targetDirectory="" />
    <file action="copy" path="../5_USB_HostMouse_Driverlib.c" targetDirectory="" />
  </project>
</projectSpec>
