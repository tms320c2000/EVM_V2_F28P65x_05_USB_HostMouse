<projectSpec>
  <project
        name="5_USB_HostMouse_Bitfield"
        device="TMS320F28P650DK9"
        cgtVersion="22.6.3.LTS"
        products="C2000WARE"
        outputFormat="ELF"
        launchWizard="False"
        linkerCommandFile=""
        >
    <!--
      DriverLib을 전혀 쓰지 않는 자기완결형 프로젝트입니다 (driverlib.lib 없음).
      USB 스택 자체는 TI USB Host Library(usblib.lib, 사전 빌드된 라이브러리)를 그대로
      사용합니다 - usblib API 호출부는 DriverLib 버전과 동일하고, GPIO/클럭/인터럽트
      초기화만 클래식 레지스터 비트필드로 직접 작성했습니다.
    -->
    <configuration name="CPU1_RAM"
        compilerBuildOptions="--opt_level=off -I${PROJECT_ROOT}/device/common_include -I${PROJECT_ROOT}/device/headers_include -I${PROJECT_ROOT}/usb/include --define=ccs_c2k -v28 -ml -mt --cla_support=cla2 --float_support=fpu64 --tmu_support=tmu1 --define=DEBUG --define=CPU1 --gen_func_subsections --diag_warning=225 --diag_suppress=10063"
        linkerBuildOptions="--stack_size=0x3F8 --heap_size=0x200 --entry_point code_start -i${PROJECT_ROOT} usblib.lib driverlib.lib" />
    <configuration name="CPU1_FLASH"
        compilerBuildOptions="--opt_level=off -I${PROJECT_ROOT}/device/common_include -I${PROJECT_ROOT}/device/headers_include -I${PROJECT_ROOT}/usb/include --define=ccs_c2k -v28 -ml -mt --cla_support=cla2 --float_support=fpu64 --tmu_support=tmu1 --define=DEBUG --define=CPU1 --gen_func_subsections --define=_FLASH --diag_warning=225 --diag_suppress=10063"
        linkerBuildOptions="--stack_size=0x3F8 --heap_size=0x200 --entry_point code_start --define=_FLASH -i${PROJECT_ROOT} usblib.lib driverlib.lib" />

    <file action="copy" path="../usblib.lib" targetDirectory="" applicableConfigurations="CPU1_RAM, CPU1_FLASH" />
    <file action="copy" path="../driverlib.lib" targetDirectory="" applicableConfigurations="CPU1_RAM, CPU1_FLASH" />
    <file action="copy" path="../device" targetDirectory="" />
    <file action="copy" path="../usb" targetDirectory="" />
    <file action="copy" path="../f28p65x_headers_nonBIOS_cpu1.cmd" targetDirectory="" />
    <file action="copy" path="../28p65x_generic_ram_lnk_cpu1.cmd" targetDirectory="" applicableConfigurations="CPU1_RAM" />
    <file action="copy" path="../28p65x_generic_flash_lnk_cpu1.cmd" targetDirectory="" applicableConfigurations="CPU1_FLASH" />
    <file action="copy" path="../targetConfigs/TMS320F28P650DK9.ccxml" targetDirectory="targetConfigs" />
    <file action="copy" path="../5_USB_HostMouse_Bitfield.c" targetDirectory="" />
  </project>
</projectSpec>
